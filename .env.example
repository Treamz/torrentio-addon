# Database Configuration
POSTGRES_DB=torrentio
POSTGRES_USER=torrentio
POSTGRES_PASSWORD=your_secure_password_here

# Application Configuration
METRICS_USER=admin
METRICS_PASSWORD=your_secure_metrics_password
CACHE_MAX_AGE=3600

# Traefik & SSL Configuration
DOMAIN=torrentio.example.com
ACME_EMAIL=admin@example.com

# Optional: Add your debrid service API keys if needed
# REAL_DEBRID_API_KEY=your_key_here
# PREMIUMIZE_API_KEY=your_key_here
# ALLDEBRID_API_KEY=your_key_here